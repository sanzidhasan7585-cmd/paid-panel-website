window.doLogin = async function(){
    const p = document.getElementById('loginPhone').value.trim();
    const s = document.getElementById('loginPass').value.trim();
    if(!p || !s){ alert('সব ফিল্ড পূরণ করুন!'); return; }
    try{
        const snap = await getDocs(query(collection(db, "users"), where("phone", "==", p)));
        if(snap.empty){ alert('❌ অ্যাকাউন্ট নেই!'); return; }
        let f = null;
        snap.forEach(d => { const u = d.data(); if(u.password === s){ u.id = d.id; f = u; } });
        if(!f){ alert('❌ পাসওয়ার্ড ভুল!'); return; }
        user = { id: f.id, name: f.name, phone: f.phone, wallet: f.wallet || 0, email: f.email || '', supportPin: f.supportPin || '0000', lastSpinDate: f.lastSpinDate || '' };
        localStorage.setItem('ff_user', JSON.stringify(user));
        alert('✅ লগইন সফল!'); updHead(); listenUser(); goHome();
    }catch(err){ alert('❌ ' + err.message); }
};

window.doRegister = async function(){
    const n = document.getElementById('regName').value.trim();
    const p = document.getElementById('regPhone').value.trim();
    const s = document.getElementById('regPass').value.trim();
    if(!n || !p || !s){ alert('সব ফিল্ড পূরণ করুন!'); return; }
    if(s.length < 4){ alert('পাসওয়ার্ড কমপক্ষে ৪!'); return; }
    if(p.length < 11){ alert('সঠিক নাম্বার দিন!'); return; }
    try{
        const e = await getDocs(query(collection(db, "users"), where("phone", "==", p)));
        if(!e.empty){ alert('❌ এই নাম্বারে অ্যাকাউন্ট আছে!'); return; }
        const nd = await addDoc(collection(db, "users"), { name: n, phone: p, password: s, wallet: 0, email: '', supportPin: Math.floor(1000 + Math.random() * 9000).toString(), createdAt: new Date().toLocaleString() });
        user = { id: nd.id, name: n, phone: p, wallet: 0, email: '', supportPin: '' };
        localStorage.setItem('ff_user', JSON.stringify(user));
        alert('✅ রেজিস্ট্রেশন সফল!'); updHead(); listenUser(); goHome();
    }catch(err){ alert('❌ ' + err.message); }
};

