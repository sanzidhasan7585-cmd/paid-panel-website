    if(b) b.innerText = '৳ ' + (user ? (user.wallet || 0) : 0);
};

function listenUser(){
    if(!user || !user.id) return;
    onSnapshot(doc(db, "users", user.id), d => {
        if(d.exists()){
            const u = d.data();
            user.wallet = u.wallet || 0;
            user.supportPin = u.supportPin || '0000';
            localStorage.setItem('ff_user', JSON.stringify(user));
            updHead();
        }
    });
}

async function loadCats(){
    try{
        const snap = await getDocs(collection(db, "panels"));
        const cats = new Set();
        snap.forEach(d => { const c = d.data().category; if(c && c.trim()) cats.add(c.trim()); });
        let h = '<div class="cat-chip active" onclick="setCat(\'ALL\',this)">ALL</div>';
        cats.forEach(c => { h += '<div class="cat-chip" onclick="setCat(\'' + c + '\',this)">' + c + '</div>'; });
        document.getElementById('catChips').innerHTML = h;
    }catch(e){ console.log(e); }
}

window.setCat = function(cat, el){
    currentFilter = cat;
    document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    loadPanels();
};

window.searchPanels = function(){
    searchFilter = document.getElementById('searchInput').value.toLowerCase().trim();
    loadPanels();
};

async function loadPanels(){
    const g = document.getElementById('panelGrid');
    g.innerHTML = '<div style="grid-column:span 2;text-align:center;padding:40px;color:#ffc107;font-size:12px">⏳ প্যানেল লোড হচ্ছে...</div>';
    try{
        const snap = await getDocs(collection(db, "panels"));
        if(snap.empty){ g.innerHTML = '<div style="grid-column:span 2;text-align:center;color:#ff3b3b;font-size:12px">❌ কোনো প্যানেল নেই</div>'; return; }
        let h = '';
        snap.forEach(d => {
            const p = d.data();
            if(currentFilter !== 'ALL' && p.category !== currentFilter) return;
            if(searchFilter && !(p.title || '').toLowerCase().includes(searchFilter)) return;
            const img = p.image ? '<img src="' + p.image + '">' : (p.title || 'PANEL');
            let stH = '', cls = 'panel-card', bt = 'BUY NOW';
            const st = p.stock === undefined ? 'in' : p.stock;
            if(st === 'out'){ stH = '<div style="background:#ef4444;color:#fff;font-size:8px;padding:2px 6px;border-radius:5px;display:inline-block;margin-bottom:4px">❌ স্টক নেই</div>'; cls = 'panel-card out-of-stock'; bt = 'OUT OF STOCK'; }
            else if(st === 'low'){ stH = '<div style="background:#f59e0b;color:#fff;font-size:8px;padding:2px 6px;border-radius:5px;display:inline-block;margin-bottom:4px">⚠️ লিমিটেড</div>'; }
            const cf = st === 'out' ? '' : 'onclick="openDetails(\'' + d.id + '\')"';
            h += '<div class="' + cls + '" ' + cf + ' style="' + (st === 'out' ? 'opacity:.5;' : '') + '"><div class="pc-img">' + img + '</div><div class="pc-body">' + stH + '<div class="pc-title">' + (p.title || 'N/A') + '</div><div class="pc-price">৳ ' + (p.price || 0) + '</div><button class="pc-btn pc-buy">' + bt + '</button></div></div>';
        });
        g.innerHTML = h || '<div style="grid-column:span 2;text-align:center;color:#ff3b3b;font-size:12px">❌ কোনো প্যানেল নেই</div>';
    }catch(e){ g.innerHTML = '<div style="grid-column:span 2;text-align:center;color:#ff3b3b;font-size:12px">❌ লোড ফেইল</div>'; }
}

function loadLiveOrders(){
    onSnapshot(collection(db, "orders"), snap => {
        const list = document.getElementById('liveOrdersList');
        if(!list) return;
        if(snap.empty){ list.innerHTML = '<div class="live-empty">⏳ কোনো অর্ডার নেই</div>'; return; }
        let arr = []; snap.forEach(d => { const x = d.data(); x.id = d.id; arr.push(x); });
        arr.sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0)); arr = arr.slice(0, 8);
        const cl = ['#10b981','#3b82f6','#f59e0b','#ec4899','#8b5cf6','#ef4444','#06b6d4','#84cc16'];
        let h = '';
        arr.forEach((o, i) => {
            const n = (o.userName || 'User').trim();
            let st = o.status === 'Confirmed' ? '<div class="live-status live-done">✅ DONE</div>' : o.status === 'Pending' ? '<div class="live-status live-pending">⏳ PENDING</div>' : '<div class="live-status live-cancel">❌ CANCEL</div>';
            h += '<div class="live-item"><div class="live-user"><div class="live-avatar" style="background:' + cl[i % cl.length] + '">' + n.charAt(0).toUpperCase() + '</div><div style="flex:1;min-width:0"><div class="live-name">' + n + '</div><div class="live-panel">' + (o.panel || 'Panel') + '</div></div></div>' + st + '</div>';
        });
        list.innerHTML = h;
    });
}

function loadTopBuyers(){
    onSnapshot(collection(db, "orders"), snap => {
        const list = document.getElementById('topBuyersList');
        if(!list) return;
        const tot = {};
        snap.forEach(d => { const x = d.data(); if(x.status === 'Confirmed'){ const n = x.userName || 'User'; tot[n] = (tot[n] || 0) + (x.price || 0); } });
        const arr = Object.entries(tot).map(([n,a]) => ({name:n, amount:a})).sort((a,b) => b.amount - a.amount).slice(0, 5);
        if(arr.length === 0){ list.innerHTML = '<div class="tb-empty">এখনো কোনো বায়ার নেই</div>'; return; }
        const cl = ['#10b981','#3b82f6','#8b5cf6','#f59e0b','#ec4899'];
        let h = '';
        arr.forEach((b, i) => { h += '<div class="tb-row"><div class="tb-rank" style="color:' + cl[i] + '">' + (i+1) + '</div><div class="tb-name">' + b.name + '</div><div class="tb-amount">' + b.amount.toFixed(2) + ' ৳</div></div>'; });
        list.innerHTML = h;
    });
}

