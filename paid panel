    const btn = document.getElementById('spinBtn');
    if(btn.innerText === 'WAIT') return;
    btn.innerText = 'WAIT'; btn.style.background = '#4b5563';
    
    const randomNum = Math.random() * 100;
    let amountWon = 0;
    let targetRotation = 0;

    if(randomNum <= 60){
        amountWon = 0;
        targetRotation = 1800 + 45; 
    } else {
        const prizes = [1, 2, 3];
        amountWon = prizes[Math.floor(Math.random() * prizes.length)];
        targetRotation = 1800 + (amountWon * 90); 
    }

    currentRotation += targetRotation;
    const wheel = document.getElementById('spinWheel');
    wheel.style.transform = `rotate(${currentRotation}deg)`;

    setTimeout(async () => {
        const today = new Date().toDateString();
        if(amountWon > 0){
            const newBal = (user.wallet || 0) + amountWon;
            await updateDoc(doc(db, "users", user.id), { wallet: newBal, lastSpinDate: today });
            user.wallet = newBal; localStorage.setItem('ff_user', JSON.stringify(user));
            updHead(); alert('🎉 অভিনন্দন! আপনি ৳' + amountWon + ' জিতেছেন!');
        } else {
            await updateDoc(doc(db, "users", user.id), { lastSpinDate: today });
            alert('😢 দুঃখিত, এবার ৳০ পেয়েছেন। আগামীকাল আবার চেষ্টা করুন!');
        }
        closeModal('spinModal'); btn.innerText = 'কাল'; btn.style.background = '#1e293b';
    }, 4200); 
};

window.openWhatsApp = function(){
    const msg = "আসসালামু আলাইকুম। আমি PaiD PaNeL অ্যাপ থেকে সাহায্যের জন্য যোগাযোগ করছি।";
    window.open("https://wa.me/" + WA + "?text=" + encodeURIComponent(msg), "_blank");
};

window.copyVal = function(txt){
    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(txt).then(() => alert('✅ কপি হয়েছে: ' + txt)).catch(() => fallbackCopy(txt));
    } else { fallbackCopy(txt); }
};

function fallbackCopy(text) {
    const textArea = document.createElement("textarea");
    textArea.value = text; textArea.style.position = "fixed"; textArea.style.left = "-999999px";
    document.body.appendChild(textArea); textArea.focus(); textArea.select();
    try { document.execCommand('copy'); alert('✅ কপি হয়েছে: ' + text); } catch (err) { alert('❌ কপি করা যায়নি! ম্যানুয়ালি কপি করুন: ' + text); }
    document.body.removeChild(textArea);
}
