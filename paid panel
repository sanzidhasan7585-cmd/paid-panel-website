window.submitOrder = async function(){
    const t = document.getElementById('trxId').value.trim().toUpperCase();
    if(!t || t.length < 6){ alert('❌ সঠিক TrxID দিন!'); return; }
    const total = selPkg.price * qty;
    try{
        const dup = await getDocs(query(collection(db, "orders"), where("trxId", "==", t)));
        if(!dup.empty){ alert('❌ TrxID আগেই ব্যবহৃত!'); return; }
        await addDoc(collection(db, "orders"), {
            userName: user.name, userPhone: user.phone, panel: curPanel.title,
            package: selPkg.name, qty: qty, price: total, trxId: t, paymentMethod: 'Instant',
            status: "Pending", date: new Date().toLocaleString(), timestamp: Date.now()
        });
        alert('✅ অর্ডার সফল! এডমিন চেক করে কোড দিবে।'); closeModal('buyModal'); goHome();
    }catch(e){ alert('❌ ' + e.message); }
};

window.submitOrderWallet = async function(){
    const total = selPkg.price * qty;
    if((user.wallet || 0) < total) {
        alert('❌ আপনার ব্যালেন্স যথেষ্ট নয়! দয়া করে Add Money করুন।');
        return;
    }
    try {
        const newBal = user.wallet - total;
        await updateDoc(doc(db, "users", user.id), { wallet: newBal });
        await addDoc(collection(db, "orders"), {
            userName: user.name, userPhone: user.phone, panel: curPanel.title,
            package: selPkg.name, qty: qty, price: total, trxId: 'WALLET-'+Date.now(), paymentMethod: 'Wallet',
            status: "Pending", date: new Date().toLocaleString(), timestamp: Date.now()
        });
        user.wallet = newBal; localStorage.setItem('ff_user', JSON.stringify(user));
        updHead();
        alert('✅ ওয়ালেট থেকে পেমেন্ট সফল! এডমিন চেক করে কোড দিবে।'); closeModal('buyModal'); goHome();
    } catch(e) {
        alert('❌ ' + e.message);
    }
};

